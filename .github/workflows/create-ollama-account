name: 🔐 Create Ollama Account

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type "create" to confirm account creation'
        required: true
        default: 'create'

jobs:
  create-account:
    if: ${{ github.event.inputs.confirm == 'create' }}
    runs-on: ubuntu-latest

    steps:
      # =============================================
      # STEP 1: Checkout
      # =============================================
      - name: 📂 Checkout Repository
        uses: actions/checkout@v4

      # =============================================
      # STEP 2: Show Info
      # =============================================
      - name: 📋 Account Info
        run: |
          echo "Creating Ollama account with:"
          echo "  Username: ${{ secrets.OLLAMA_Username }}"
          echo "  Email:    ${{ secrets.OLLAMA_Email }}"
          echo "  Password: ********"

      # =============================================
      # STEP 3: Install Ollama
      # =============================================
      - name: 📦 Install Ollama
        run: |
          curl -fsSL https://ollama.com/install.sh | sh
          echo "✅ Ollama installed"

      # =============================================
      # STEP 4: Send Signup Request
      # =============================================
      - name: 📝 Send Signup Request
        id: signup
        run: |
          echo "Sending signup request to Ollama..."

          RESPONSE=$(curl -s -w "\n%{http_code}" \
            -X POST https://ollama.com/api/auth/register \
            -H "Content-Type: application/json" \
            -d '{
              "username": "${{ secrets.OLLAMA_Username }}",
              "email": "${{ secrets.OLLAMA_Email }}",
              "password": "${{ secrets.OLLAMA_Pass }}"
            }')

          HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
          BODY=$(echo "$RESPONSE" | head -n -1)

          echo "Response code: $HTTP_CODE"
          echo "Response body: $BODY"

          if [ "$HTTP_CODE" == "200" ] || [ "$HTTP_CODE" == "201" ]; then
            echo "status=success" >> $GITHUB_OUTPUT
            echo "✅ Account created successfully!"
          elif echo "$BODY" | grep -qi "already"; then
            echo "status=exists" >> $GITHUB_OUTPUT
            echo "⚠️ Account may already exist."
          else
            echo "status=failed" >> $GITHUB_OUTPUT
            echo "❌ Signup failed. Code: $HTTP_CODE"
          fi

      # =============================================
      # STEP 5: Try Login After Signup
      # =============================================
      - name: 🔐 Try Login
        if: steps.signup.outputs.status == 'success'
        id: login
        run: |
          echo "Attempting login..."

          sleep 3

          printf '%s' "${{ secrets.OLLAMA_Pass }}" | ollama login \
            --username "${{ secrets.OLLAMA_Username }}" \
            --password-stdin ollama.com && \
            echo "status=success" >> $GITHUB_OUTPUT || \
            echo "status=verify_email" >> $GITHUB_OUTPUT

      # =============================================
      # STEP 6: Summary
      # =============================================
      - name: 📝 Summary
        run: |
          USERNAME="${{ secrets.OLLAMA_Username }}"
          EMAIL="${{ secrets.OLLAMA_Email }}"
          SIGNUP="${{ steps.signup.outputs.status }}"
          LOGIN="${{ steps.login.outputs.status }}"

          {
            echo "## 🔐 Ollama Account Setup"
            echo ""

            if [ "$SIGNUP" == "success" ]; then
              echo "### ✅ Account Created"
              echo "- **Username:** ${USERNAME}"
              echo "- **Email:** ${EMAIL}"
              echo ""
              echo "### ⚠️ Action Required"
              echo "1. Check your email inbox for **${EMAIL}**"
              echo "2. Click the **verification link** from Ollama"
              echo "3. Come back and run the **setup-orion** workflow"
              echo ""

              if [ "$LOGIN" == "success" ]; then
                echo "### ✅ Login Successful"
                echo "You are ready to push models!"
              else
                echo "### ⏳ Login Pending Email Verification"
                echo "After verifying your email, run:"
                echo '```bash'
                echo "ollama login --username ${USERNAME} ollama.com"
                echo '```'
              fi

            elif [ "$SIGNUP" == "exists" ]; then
              echo "### ⚠️ Account Already Exists"
              echo "An account with that username or email may already exist."
              echo ""
              echo "Try logging in at: https://ollama.com/signin"

            else
              echo "### ❌ Signup Failed"
              echo "Please create your account manually at:"
              echo "https://ollama.com/signup"
            fi

            echo ""
            echo "---"
            echo "### Next Steps After Verification"
            echo "1. Go to https://ollama.com/settings/keys"
            echo "2. Click **New Key**"
            echo "3. Copy the key"
            echo "4. Add it to GitHub secrets as **API_OLLAMA**"
            echo "5. Run the **Orion Build and Push** workflow"

          } >> "$GITHUB_STEP_SUMMARY"

          cat "$GITHUB_STEP_SUMMARY"
